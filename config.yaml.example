app:
  name: "PaperMind"
  version: "1.0.0"
  data_dir: "./data"

llm:
  provider: "moonshot"
  api_key: "sk-xxxxxxxx"          # 请替换为您的 Kimi API Key
  base_url: "https://api.moonshot.cn/v1"
  model: "kimi-k2-7"
  max_tokens: 4096
  temperature: 0.3

embedding:
  provider: "local"
  local_model: "BAAI/bge-m3"
  device: "auto"                  # auto / cpu / cuda / mps
  chunk_size: 512
  chunk_overlap: 50

retrieval:
  top_k: 10
  chat_profile: "semantic"          # semantic / hybrid；通过真实 dev Gate 后再切 hybrid
  lexical_profile: "bm25-bilingual" # hybrid 的 chunk 词法策略
  rerank: false                   # 默认关闭，开启后召回 top-20 经 BGE-Reranker 精排
  rerank_model: "BAAI/bge-reranker-v2-m3"
  hybrid_weight: 0.7

memory:
  enabled: true
  session_limit: 50
  summary_interval: 5
  max_short_term: 10

skills:
  auto_load: true
  skills_dir: "./skills"

ui:
  theme: "light"
  language: "zh-CN"
  page_size: 20
  default_view: "list"

export:
  citation_format: "GB/T 7714"

# MCP 客户端：连接外部 MCP server（默认关闭，取消注释即启用）。
# 外部 server 一律作为独立进程运行：stdio 型用 command+args[+env]，SSE 型用 url。
# 如 arXiv 检索经 uvx 启动（uvx 为其管理独立虚拟环境，与本项目锁定依赖零冲突）。
# mcp_servers:
#   - name: arxiv
#     command: uvx                # stdio 型：command + args [+ env]
#     args: ["arxiv-mcp-server"]
#     # env: { ... }              # 可选
#   # - name: remote-x            # SSE 型：url
#   #   url: http://127.0.0.1:9000/sse
