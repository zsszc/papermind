# Docker 构建上下文排除清单（与 .gitignore 对齐，并额外排除本地运行产物）

# 版本控制与 IDE
.git
.gitignore
.github
.vscode
.idea
**/.DS_Store

# 敏感配置（含 API Key，绝不进入镜像）
config.yaml
config.yml
.env
**/.env

# Python 虚拟环境与缓存
backend/venv/
backend/.venv/
backend/env/
**/__pycache__/
**/*.pyc
**/*.pyo
*.egg-info/

# Node 依赖与构建产物
frontend/node_modules/
electron/node_modules/
frontend/dist/
frontend/out/
frontend/release/

# 数据目录（运行时挂载，不打入镜像）
data/
papers/
notes/
summaries/
my-thesis/
vector_db/
logs/
backups/
cache/

# 模型缓存（首次启动在线下载，见 Dockerfile 注释）
models/
**/*.bin
**/*.safetensors

# 桌面端打包产物
*.dmg
*.zip
*.exe

# 文档与个人文件（不属于应用代码）
*.docx
docs/
PaperMind_*.md
面试.md
AGENTS.md

# Docker 自身
Dockerfile
docker-compose.yml
.dockerignore
