# ============================================================
# PaperMind · Langfuse 自托管可观测性（可选）环境变量模板
#
# 使用：
#   1. cp .env.example .env
#   2. 按下文注释生成 / 填写各项取值
#   3. docker compose --profile langfuse up -d
#
# 注意：.env 已在 .gitignore 中，真实密钥绝不提交 git（宪法第 14 条）。
# 完整步骤见 docs/DEPLOY.md「5. Langfuse 可观测性（可选）」。
# ============================================================

# ---------- Langfuse 服务端密钥（langfuse profile 容器使用） ----------
# NextAuth 会话加密密钥，生成：openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
# API Key 哈希盐，生成：openssl rand -base64 32
LANGFUSE_SALT=
# 敏感字段加密密钥，必须为 64 位十六进制，生成：openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
# 内置 Postgres 密码（不填则用 compose 中占位默认值 postgres）
LANGFUSE_POSTGRES_PASSWORD=
# 内置 ClickHouse 密码（占位默认 clickhouse）
LANGFUSE_CLICKHOUSE_PASSWORD=
# 内置 MinIO root 密码（用户名固定 minio，至少 8 位；占位默认 miniosecret）
LANGFUSE_MINIO_ROOT_PASSWORD=
# Web 控制台外部访问地址（对应 compose 端口映射 3001:3000，一般无需改）
LANGFUSE_NEXTAUTH_URL=http://localhost:3001

# ---------- 可选：首次启动自动播种组织 / 项目 / 账号 / API 密钥对 ----------
# 整组填写才生效；全部留空则首次启动后在 http://localhost:3001 手工创建
#（注册账号 → 建组织/项目 → Project Settings → API Keys）。
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
# 播种的项目 API 密钥对（建议格式 pk-lf-... / sk-lf-...），
# 即下方后端对接要用的 LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=

# ---------- 后端对接（PaperMind 后端进程读取 PAPERMIND_LANGFUSE_*） ----------
# Langfuse 项目密钥对：来自上方播种值，或 UI「Project Settings → API Keys」创建
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 宿主机直跑后端时使用的 Langfuse 地址（Web 控制台同地址）
LANGFUSE_HOST=http://localhost:3001

# 对接方式（二选一，详见 DEPLOY.md 5.3 节）：
#   · compose 部署后端：docker-compose.yml 自动把上方 LANGFUSE_PUBLIC_KEY /
#     LANGFUSE_SECRET_KEY 透传为 backend 容器的 PAPERMIND_LANGFUSE_*，
#     HOST 默认走 compose 内网 http://langfuse-web:3000；
#   · 宿主机直跑后端：export 下面三个同名变量，HOST 用 http://localhost:3001。
# 如需区分两套环境，可直接设置以下变量（优先级高于上方透传）：
# PAPERMIND_LANGFUSE_PUBLIC_KEY=
# PAPERMIND_LANGFUSE_SECRET_KEY=
# PAPERMIND_LANGFUSE_HOST=
# 提醒：两个密钥缺一即视为未配置，后端零侵入跳过观测，不影响主链路。
