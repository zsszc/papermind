{
  "name": "papermind-electron",
  "version": "1.0.0",
  "description": "PaperMind 桌面端 Electron 壳",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:runtime": "node scripts/prepare-runtime.js",
    "build": "npm run prepare:runtime && electron-builder",
    "build:dir": "npm run prepare:runtime && electron-builder --dir",
    "test": "node --test test/*.test.js",
    "smoke:identity": "node scripts/smoke-backend-identity.js",
    "verify:artifact": "node scripts/verify-artifact.js"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
